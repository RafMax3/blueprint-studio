{
  "name": "blueprint-studio",
  "productName": "Blueprint Studio",
  "version": "1.0.0",
  "description": "Editeur de graphes de noeuds (blueprints) generant du Python, C# et C++",
  "author": "Blueprint Studio",
  "private": true,
  "scripts": {
    "start": "cargo run --manifest-path src-tauri/Cargo.toml",
    "check": "node tools/check.js",
    "coverage": "node tools/coverage.js",
    "test": "npm run check && npm run coverage && npm run unity && npm run test:rust",
    "unity": "node tools/unity-check.js",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "smoke": "node tools/smoke.js",
    "examples": "node tools/export-examples.js",
    "icon": "node tools/make-icon.js",
    "build": "cargo build --release --manifest-path src-tauri/Cargo.toml",
    "installer": "tauri build",
    "dist": "npm run build && node tools/dist.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6"
  }
}
